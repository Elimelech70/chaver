# Chaver's language faculty needs an Anthropic API key.
# Copy this file to .env and fill in your key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the language faculty model.
# Defaults to claude-sonnet-5 — capable and cost-appropriate for
# on-demand use. Swap to claude-opus-4-7 for weightier work.
# CHAVER_MODEL=claude-sonnet-5
