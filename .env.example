# Chaver's language faculty needs an Anthropic API key.
# Copy this file to .env and fill in your key.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the language faculty model.
# Defaults to claude-sonnet-5 — capable and cost-appropriate for
# on-demand use. Swap to claude-opus-4-7 for weightier work.
# CHAVER_MODEL=claude-sonnet-5

# Telnet chat front end (converse with the running Chaver over telnet).
# On by default, bound to localhost. Set CHAVER_TELNET=0 to disable.
CHAVER_TELNET=1
CHAVER_TELNET_HOST=127.0.0.1
CHAVER_TELNET_PORT=8023
