# ── Language Backend ─────────────────────────────────────────────────────────────────────────────
#
# Select which LLM backend Chaver uses for language generation.
# Two supported backends:
#
#   anthropic  — Anthropic API (for droplet / cloud deployment)
#   ollama     — Local Ollama server (for laptop deployment)
#
CHAVER_BACKEND=anthropic

# ── Model Selection ───────────────────────────────────────────────────────────────────
#
# Select the specific model within the chosen backend.
# Change CHAVER_MODEL only — no code change required.
#
# Anthropic models:
#   claude-sonnet-5             (default — capable, cost-appropriate)
#   claude-opus-5               (weightier reasoning, higher cost)
#   claude-haiku-4-5-20251001   (faster, lighter tasks)
#
# Ollama models (must be pulled first with `ollama pull <model>`):
#   qwen3        (default for ollama)
#   llama3.2
#   llama3.1
#   mistral
#   gemma3
#   phi4
#   deepseek-r1
#
CHAVER_MODEL=claude-sonnet-5

# ── Anthropic API Key (required when CHAVER_BACKEND=anthropic) ────────────────
#
ANTHROPIC_API_KEY=sk-ant-...

# ── Telnet Chat Front End ─────────────────────────────────────────────────────
#
# Enables a telnet conversation interface alongside stdin.
# Set CHAVER_TELNET=0 to disable.
#
CHAVER_TELNET=1
CHAVER_TELNET_HOST=127.0.0.1
CHAVER_TELNET_PORT=8023

# ── Telegram Chat Front End ───────────────────────────────────────────────────
#
# Enables a Telegram bot conversation interface alongside stdin/telnet.
# Requires the `telegram` extra: pip install -e ".[telegram]"
# Off by default. Fails closed: with an empty allowlist, no sender is
# processed even if CHAVER_TELEGRAM=1.
#
CHAVER_TELEGRAM=0
CHAVER_TELEGRAM_TOKEN=              # bot token from @BotFather
CHAVER_TELEGRAM_ALLOWLIST=          # comma-separated chat IDs, from @userinfobot

# ── Web Search — Chaver's Eyes ────────────────────────────────────────────────────
#
# Tavily-powered web search. When memory recall similarity falls below
# the gap threshold, Chaver searches the web to enrich his ringing field
# before responding. Results are encoded, stored as episodes, and recalled
# in future conversations.
#
# Requires the `search` extra: pip install -e ".[search]"
# Get a free API key at https://tavily.com
#
TAVILY_API_KEY=                     # required to enable web search
CHAVER_SEARCH_RESULTS=5             # max results per search query (default: 5)
